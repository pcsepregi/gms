{
  "name": "gms",
  "private": true,
  "version": "0.1.0",
  "description": "Lechonk & Oinkologne Grand Master Set gyűjteménykezelő (helyi webapp)",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/web"
  ],
  "scripts": {
    "build": "npm run build -w @gms/shared && npm run build -w @gms/server && npm run build -w @gms/web",
    "typecheck": "npm run build -w @gms/shared && npm run typecheck --workspaces",
    "lint": "eslint . && prettier --check . && node scripts/check-source.mjs",
    "format": "prettier --write .",
    "test": "npm test --workspaces",
    "e2e": "playwright test",
    "start": "node packages/server/dist/main.js",
    "dev": "npm run dev -w @gms/server",
    "import": "node packages/server/dist/cli/import.js",
    "fixtures": "tsx scripts/make-fixtures.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.1",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "exceljs": "^4.4.0",
    "globals": "^17.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
